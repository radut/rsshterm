[Desktop Entry]
Type=Application
Name=rSshTerm
GenericName=Terminal
Comment=Terminal tabs and splits with an encrypted SSH vault built in
Exec=rsshterm
Icon=dev.rsshterm.RSSHTerm
Terminal=false
Categories=System;TerminalEmulator;GTK;
Keywords=ssh;terminal;shell;vault;agent;console;
StartupNotify=true
StartupWMClass=dev.rsshterm.RSSHTerm
DBusActivatable=false
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=rsshterm
