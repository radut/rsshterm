<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd AGENT (per user), installed to ~/Library/LaunchAgents/ by install.sh, which rewrites the program path. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.rssh.rsshd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/rsshd</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- Only the daemon: launchd must not kill the tmux server it started when the agent restarts. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
